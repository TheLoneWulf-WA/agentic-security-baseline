{
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__USER_HOME__/.claude/hooks/push-routing-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__USER_HOME__/.claude/hooks/config-edit-gate.sh"
          }
        ]
      }
    ]
  }
}
